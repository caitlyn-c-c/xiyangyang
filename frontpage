<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Cloud — A Gentle Journal</title>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Lato:wght@300;400&display=swap" rel="stylesheet"/>
<style>
  :root {
    --rain-blue:    #7a9ab5;
    --mist:         #b8cdd8;
    --fog:          #d6e3ea;
    --parchment:    #f0ebe2;
    --moss:         #7a8c6e;
    --bark:         #5c4a3a;
    --ink:          #2e2a26;
    --dusk:         #4a6070;
    --pale-gold:    #c9b882;
    --glass:        rgba(240,235,226,0.55);
    --glass-border: rgba(255,255,255,0.35);
    --journal-bg:   #3d5060;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Lato', sans-serif;
    background: #8ea8b8;
    min-height: 100vh;
    overflow-x: hidden;
    color: var(--ink);
    user-select: none;
  }
  textarea, input { user-select: text; }

  .page { display: none; width: 100%; min-height: 100vh; }
  .page.active { display: flex; }

  /* ══ WELCOME PAGE ══ */
  #welcome-page { flex-direction: column; position: relative; overflow: hidden; }

  .sky {
    position: absolute; inset: 0;
    background: linear-gradient(180deg,#4d6878 0%,#6b8fa3 30%,#8ea8b8 60%,#a8c0cc 80%,#c4d6de 100%);
  }

  /* Ghibli sky clouds */
  .cloud-layer { position:absolute; top:0; left:0; width:100%; height:58%; pointer-events:none; overflow:hidden; }
  .ghibli-cloud { position:absolute; pointer-events:none; }
  @keyframes cloudDrift { from{transform:translateX(-110%)} to{transform:translateX(110vw)} }
  @keyframes cloudDriftR { from{transform:translateX(110vw)} to{transform:translateX(-110%)} }

  .mountains { position:absolute; bottom:28%; width:100%; height:260px; pointer-events:none; }
  .mountains svg { width:100%; height:100%; }

  .hills { position:absolute; bottom:18%; width:120%; left:-10%; height:200px; pointer-events:none; }
  .hills svg { width:100%; height:100%; }

  /* Grassy ground */
  .ground { position:absolute; bottom:0; width:100%; height:22%; overflow:hidden; }
  .ground-base {
    position:absolute; inset:0;
    background:linear-gradient(180deg,#90bf7c 0%,#74a860 30%,#5a8c48 65%,#477040 100%);
  }
  #grassSvg { position:absolute; top:-30px; left:0; width:100%; height:65px; }
  #flowerLayer { position:absolute; inset:0; }
  .flower { position:absolute; pointer-events:none; bottom:0; }

  .puddle {
    position:absolute; bottom:4%; border-radius:50%;
    background:rgba(155,198,220,0.5); filter:blur(1px);
    animation:puddleRipple 3.5s ease-in-out infinite;
  }
  @keyframes puddleRipple { 0%,100%{transform:scaleX(1);} 50%{transform:scaleX(1.05);} }
  .puddle-1{width:80px;height:18px;left:12%;}
  .puddle-2{width:120px;height:24px;left:52%;animation-delay:-1.2s;}
  .puddle-3{width:55px;height:14px;left:76%;animation-delay:-0.6s;}

  .trees { position:absolute; bottom:18%; width:100%; pointer-events:none; }

  /* Rain */
  .rain-layer { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
  .drop {
    position:absolute; top:-20px; width:1.5px;
    background:linear-gradient(180deg,transparent,rgba(180,210,230,0.7));
    border-radius:2px; animation:fall linear infinite;
  }
  @keyframes fall { to{transform:translateY(110vh) translateX(28px);opacity:0;} }

  .mist-layer {
    position:absolute; width:200%; height:80px;
    background:linear-gradient(90deg,transparent 0%,rgba(214,227,234,0.55) 30%,rgba(214,227,234,0.7) 50%,rgba(214,227,234,0.55) 70%,transparent 100%);
    border-radius:50%; filter:blur(18px); animation:drift linear infinite; pointer-events:none;
  }
  @keyframes drift { from{transform:translateX(-50%);} to{transform:translateX(0%);} }

  /* Pixel character */
  .character-wrap {
    position:absolute; bottom:21%; left:50%; transform:translateX(-50%);
    animation:bob 5s ease-in-out infinite;
    image-rendering:pixelated;
  }
  @keyframes bob { 0%,100%{transform:translateX(-50%) translateY(0);} 50%{transform:translateX(-50%) translateY(-4px);} }
  .pixel-canvas { image-rendering:pixelated; image-rendering:crisp-edges; display:block; }

  /* Title */
  .title-card { position:absolute; top:12%; left:50%; transform:translateX(-50%); text-align:center; z-index:10; white-space:nowrap; }
  .title-eyebrow { font-family:'Lato',sans-serif; font-weight:300; font-size:0.75rem; letter-spacing:0.35em; color:rgba(240,235,226,0.75); text-transform:uppercase; margin-bottom:10px; }
  .title-main {
    font-family:'EB Garamond',serif; font-size:clamp(5rem,13vw,9rem); font-weight:500;
    color:var(--parchment); line-height:0.9;
    text-shadow:0 2px 30px rgba(74,96,112,0.5),0 0 80px rgba(130,170,190,0.3);
  }
  .title-sub { font-family:'EB Garamond',serif; font-style:italic; font-size:1.1rem; color:rgba(240,235,226,0.7); margin-top:6px; letter-spacing:0.05em; }

  .weather-badge {
    position:absolute; top:5%; right:5%;
    background:var(--glass); border:1px solid var(--glass-border); border-radius:50px;
    padding:8px 18px; backdrop-filter:blur(12px);
    display:flex; align-items:center; gap:8px;
    font-family:'Lato',sans-serif; font-size:0.8rem; font-weight:300; color:var(--dusk); z-index:10;
  }

  .enter-wrap { position:absolute; bottom:9%; left:50%; transform:translateX(-50%); text-align:center; z-index:10; }
  .enter-btn {
    font-family:'EB Garamond',serif; font-size:1rem; font-style:italic;
    color:rgba(240,235,226,0.85); background:rgba(90,120,140,0.35);
    border:1px solid rgba(255,255,255,0.3); border-radius:40px; padding:12px 38px;
    cursor:pointer; backdrop-filter:blur(10px); transition:all 0.35s ease; letter-spacing:0.06em;
  }
  .enter-btn:hover { background:rgba(90,120,140,0.6); color:var(--parchment); transform:translateY(-2px); box-shadow:0 8px 30px rgba(60,90,110,0.4); }

  .swipe-hint {
    position:absolute; bottom:3.5%; left:50%; transform:translateX(-50%);
    font-family:'Lato',sans-serif; font-size:0.62rem; letter-spacing:0.15em; text-transform:uppercase;
    color:rgba(240,235,226,0.38); z-index:10; animation:hintFade 3s ease-in-out infinite; white-space:nowrap;
  }
  @keyframes hintFade { 0%,100%{opacity:0.38;} 50%{opacity:0.7;} }

  /* ══ JOURNAL PAGE ══ */
  #journal-page { flex-direction:row; min-height:100vh; position:relative; overflow:hidden; background:var(--journal-bg); }

  .journal-scene { position:absolute; inset:0; pointer-events:none; z-index:0; }
  .journal-sky {
    position:absolute; inset:0;
    background:linear-gradient(180deg,#263540 0%,#344d5c 40%,#415e6e 70%,#4e6a78 100%);
  }
  .window-pane {
    position:absolute; inset:0;
    background-image:linear-gradient(rgba(255,255,255,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.025) 1px,transparent 1px);
    background-size:90px 90px;
  }
  .journal-rain { position:absolute; inset:0; overflow:hidden; }
  .journal-clouds { position:absolute; top:0; left:0; width:100%; height:50%; overflow:hidden; opacity:0.45; }
  .journal-mountains { position:absolute; bottom:0; width:100%; height:42%; opacity:0.16; }
  .journal-glow {
    position:absolute; bottom:0; left:50%; transform:translateX(-50%);
    width:700px; height:350px;
    background:radial-gradient(ellipse at 50% 100%,rgba(201,184,130,0.14) 0%,rgba(201,184,130,0.05) 50%,transparent 75%);
  }

  /* Sidebar */
  .sidebar {
    width:268px; min-height:100vh;
    background:rgba(26,38,48,0.84); backdrop-filter:blur(22px);
    display:flex; flex-direction:column; padding:36px 22px;
    border-right:1px solid rgba(122,154,181,0.14);
    flex-shrink:0; position:relative; z-index:2;
  }
  .sidebar::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg,#7a9ab5,#8fa080,#c9b882); }
  .sidebar-logo { font-family:'EB Garamond',serif; font-size:1.9rem; font-weight:500; color:var(--fog); margin-bottom:3px; }
  .sidebar-tagline { font-family:'EB Garamond',serif; font-style:italic; font-size:0.82rem; color:rgba(182,205,216,0.42); margin-bottom:32px; }

  .new-entry-btn {
    display:flex; align-items:center; gap:10px;
    background:rgba(122,154,181,0.2); color:var(--fog);
    border:1px solid rgba(122,154,181,0.28); border-radius:12px;
    padding:12px 18px; font-family:'EB Garamond',serif; font-size:0.95rem;
    cursor:pointer; transition:all 0.22s; margin-bottom:28px; width:100%;
  }
  .new-entry-btn:hover { background:rgba(122,154,181,0.35); transform:translateY(-1px); }
  .new-entry-btn .plus { font-size:1.2rem; }

  .sidebar-section-title { font-family:'Lato',sans-serif; font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(182,205,216,0.3); margin-bottom:10px; padding-left:4px; }

  .entries-list { flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:4px; scrollbar-width:thin; scrollbar-color:rgba(122,154,181,0.2) transparent; }
  .entry-item { padding:11px 13px; border-radius:9px; cursor:pointer; transition:all 0.18s; border:1px solid transparent; }
  .entry-item:hover { background:rgba(122,154,181,0.12); border-color:rgba(122,154,181,0.15); }
  .entry-item.active { background:rgba(122,154,181,0.2); border-color:rgba(122,154,181,0.25); }
  .entry-item-title { font-family:'EB Garamond',serif; font-size:0.92rem; color:var(--fog); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-bottom:2px; }
  .entry-item-date { font-size:0.67rem; color:rgba(182,205,216,0.38); }
  .entry-item-mood { font-size:0.72rem; margin-top:3px; }

  .sidebar-bottom { margin-top:16px; padding-top:16px; border-top:1px solid rgba(122,154,181,0.1); }
  .back-btn { background:none; border:none; color:rgba(182,205,216,0.38); font-family:'EB Garamond',serif; font-style:italic; font-size:0.85rem; cursor:pointer; transition:color 0.2s; padding:0; }
  .back-btn:hover { color:rgba(182,205,216,0.75); }
  .swipe-note { font-family:'Lato',sans-serif; font-size:0.57rem; letter-spacing:0.1em; color:rgba(182,205,216,0.18); margin-top:5px; text-transform:uppercase; }

  /* Journal main */
  .journal-main { flex:1; display:flex; flex-direction:column; overflow-y:auto; position:relative; z-index:2; }

  /* Paper card */
  .editor-wrap {
    flex:1; display:flex; flex-direction:column;
    max-width:700px; width:100%; margin:44px auto;
    padding:52px 56px;
    background:rgba(240,235,226,0.93); backdrop-filter:blur(18px);
    border-radius:3px;
    box-shadow:0 32px 80px rgba(16,26,36,0.55),0 0 0 1px rgba(255,255,255,0.12),inset 0 1px 0 rgba(255,255,255,0.6);
    position:relative;
  }
  .editor-wrap::before {
    content:''; position:absolute; inset:52px 56px;
    background-image:repeating-linear-gradient(180deg,transparent,transparent 37px,rgba(122,154,181,0.1) 37px,rgba(122,154,181,0.1) 38px);
    pointer-events:none; z-index:0;
  }

  .mood-row { display:flex; align-items:center; gap:8px; margin-bottom:22px; flex-wrap:wrap; position:relative; z-index:1; }
  .mood-label { font-family:'Lato',sans-serif; font-size:0.67rem; letter-spacing:0.18em; text-transform:uppercase; color:rgba(92,74,58,0.48); margin-right:2px; }
  .mood-btn { background:none; border:1px solid rgba(92,74,58,0.17); border-radius:40px; padding:5px 13px; font-size:0.82rem; color:rgba(92,74,58,0.52); cursor:pointer; transition:all 0.2s; }
  .mood-btn:hover,.mood-btn.selected { background:var(--bark); color:var(--parchment); border-color:var(--bark); }

  .entry-date-line { font-family:'EB Garamond',serif; font-style:italic; font-size:0.87rem; color:rgba(92,74,58,0.38); margin-bottom:18px; position:relative; z-index:1; }
  .entry-title-input { font-family:'EB Garamond',serif; font-size:2.2rem; font-weight:500; color:var(--ink); border:none; background:transparent; outline:none; width:100%; margin-bottom:20px; resize:none; line-height:1.2; position:relative; z-index:1; }
  .entry-title-input::placeholder { color:rgba(46,42,38,0.2); }
  .entry-divider { height:1px; background:linear-gradient(90deg,rgba(92,74,58,0.18),transparent); margin-bottom:22px; position:relative; z-index:1; }
  .entry-body-input { font-family:'EB Garamond',serif; font-size:1.12rem; line-height:1.95; color:var(--ink); border:none; background:transparent; outline:none; width:100%; flex:1; resize:none; min-height:300px; position:relative; z-index:1; }
  .entry-body-input::placeholder { color:rgba(46,42,38,0.19); font-style:italic; }
  .editor-toolbar { display:flex; align-items:center; justify-content:space-between; padding-top:18px; border-top:1px solid rgba(92,74,58,0.1); margin-top:18px; position:relative; z-index:1; }
  .word-count { font-size:0.72rem; color:rgba(92,74,58,0.32); letter-spacing:0.08em; }
  .save-btn { font-family:'EB Garamond',serif; font-size:0.92rem; color:var(--parchment); background:linear-gradient(135deg,#7a9ab5,#5e7a8a); border:none; border-radius:30px; padding:10px 30px; cursor:pointer; transition:all 0.25s; letter-spacing:0.04em; }
  .save-btn:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(90,130,155,0.5); }
  .save-btn.saved { background:linear-gradient(135deg,#7a8c6e,#5e7055); }

  .view-entry { flex:1; display:flex; flex-direction:column; max-width:700px; width:100%; margin:44px auto; padding:52px 56px; background:rgba(240,235,226,0.93); backdrop-filter:blur(18px); border-radius:3px; box-shadow:0 32px 80px rgba(16,26,36,0.55),0 0 0 1px rgba(255,255,255,0.12); }
  .view-entry-mood { font-size:1.1rem; margin-bottom:8px; }
  .view-entry-date { font-family:'EB Garamond',serif; font-style:italic; font-size:0.87rem; color:rgba(92,74,58,0.42); margin-bottom:18px; }
  .view-entry-title { font-family:'EB Garamond',serif; font-size:2.2rem; font-weight:500; color:var(--ink); margin-bottom:22px; line-height:1.2; }
  .view-entry-divider { height:1px; background:linear-gradient(90deg,rgba(92,74,58,0.18),transparent); margin-bottom:22px; }
  .view-entry-body { font-family:'EB Garamond',serif; font-size:1.12rem; line-height:1.95; color:var(--ink); white-space:pre-wrap; flex:1; }
  .view-entry-actions { display:flex; gap:10px; margin-top:34px; }
  .edit-btn { font-family:'EB Garamond',serif; font-size:0.92rem; background:none; border:1px solid rgba(92,74,58,0.22); border-radius:30px; padding:9px 26px; color:var(--bark); cursor:pointer; transition:all 0.2s; }
  .edit-btn:hover { background:rgba(92,74,58,0.07); }
  .delete-btn { font-family:'EB Garamond',serif; font-size:0.92rem; background:none; border:1px solid rgba(160,60,60,0.22); border-radius:30px; padding:9px 26px; color:rgba(148,55,55,0.7); cursor:pointer; transition:all 0.2s; }
  .delete-btn:hover { background:rgba(160,60,60,0.06); }

  .empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; flex:1; padding:80px 40px; text-align:center; color:rgba(182,205,216,0.48); }
  .empty-state-glyph { font-size:2.5rem; margin-bottom:18px; opacity:0.45; }
  .empty-state h2 { font-family:'EB Garamond',serif; font-size:1.5rem; font-weight:400; font-style:italic; color:rgba(182,205,216,0.52); margin-bottom:10px; }
  .empty-state p { font-size:0.85rem; line-height:1.7; max-width:300px; }

  .page-transition { position:fixed; inset:0; background:#3a5060; z-index:999; opacity:0; pointer-events:none; transition:opacity 0.38s ease; }
  .page-transition.in { opacity:1; pointer-events:all; }

  .toast { position:fixed; bottom:28px; left:50%; transform:translateX(-50%) translateY(60px); background:rgba(26,38,48,0.95); color:var(--fog); font-family:'EB Garamond',serif; font-style:italic; font-size:0.92rem; padding:11px 26px; border-radius:40px; border:1px solid rgba(122,154,181,0.22); z-index:9999; transition:transform 0.35s cubic-bezier(.34,1.56,.64,1),opacity 0.35s; opacity:0; backdrop-filter:blur(12px); }
  .toast.show { transform:translateX(-50%) translateY(0); opacity:1; }

  ::-webkit-scrollbar { width:4px; }
  ::-webkit-scrollbar-track { background:transparent; }
  ::-webkit-scrollbar-thumb { background:rgba(122,154,181,0.18); border-radius:4px; }
</style>
</head>
<body>

<div class="page-transition" id="transition"></div>
<div class="toast" id="toast"></div>

<!-- ══ WELCOME PAGE ══ -->
<div class="page active" id="welcome-page">
  <div class="sky"></div>
  <div class="cloud-layer" id="cloudLayerWelcome"></div>

  <div class="mist-layer" style="bottom:38%;animation-duration:22s;opacity:0.7;"></div>
  <div class="mist-layer" style="bottom:32%;animation-duration:30s;animation-delay:-8s;opacity:0.5;"></div>
  <div class="mist-layer" style="bottom:44%;animation-duration:18s;animation-delay:-5s;opacity:0.35;"></div>

  <div class="mountains">
    <svg viewBox="0 0 1440 260" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="mtnG" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#7a9ab5" stop-opacity="0.5"/>
          <stop offset="100%" stop-color="#8faabf" stop-opacity="0.3"/>
        </linearGradient>
      </defs>
      <path fill="url(#mtnG)" d="M0,260 L0,180 L120,80 L240,140 L360,60 L480,120 L600,40 L720,110 L840,50 L960,130 L1080,70 L1200,130 L1320,80 L1440,110 L1440,260 Z"/>
      <path fill="rgba(140,170,190,0.28)" d="M0,260 L0,200 L180,110 L300,160 L420,90 L540,150 L660,80 L780,140 L900,90 L1020,160 L1140,100 L1260,155 L1440,120 L1440,260 Z"/>
    </svg>
  </div>

  <div class="hills">
    <svg viewBox="0 0 1728 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path fill="rgba(100,130,100,0.55)" d="M0,200 Q200,60 400,120 Q600,180 800,80 Q1000,-10 1200,90 Q1400,170 1728,60 L1728,200 Z"/>
      <path fill="rgba(90,120,90,0.4)" d="M0,200 Q300,100 500,140 Q700,180 900,110 Q1100,50 1300,120 Q1500,170 1728,100 L1728,200 Z"/>
    </svg>
  </div>

  <div class="trees">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:120px;">
      <g fill="#4a5c44" opacity="0.85">
        <polygon points="30,120 60,40 90,120"/><polygon points="55,120 80,55 105,120"/><polygon points="10,120 35,65 60,120"/>
        <rect x="57" y="100" width="6" height="20" fill="#3a4a34"/><rect x="82" y="105" width="6" height="15" fill="#3a4a34"/>
        <polygon points="130,120 158,35 186,120"/><polygon points="155,120 180,50 205,120"/>
        <rect x="157" y="98" width="6" height="22" fill="#3a4a34"/>
        <polygon points="380,120 405,45 430,120"/><polygon points="400,120 422,58 444,120"/>
        <rect x="403" y="100" width="6" height="20" fill="#3a4a34"/>
        <polygon points="600,120 630,30 660,120"/><polygon points="625,120 650,45 675,120"/><polygon points="650,120 672,55 694,120"/>
        <rect x="629" y="95" width="7" height="25" fill="#3a4a34"/>
        <polygon points="1250,120 1278,38 1306,120"/><polygon points="1275,120 1300,52 1325,120"/>
        <rect x="1278" y="97" width="6" height="23" fill="#3a4a34"/>
        <polygon points="1360,120 1386,42 1412,120"/><polygon points="1385,120 1408,56 1431,120"/><polygon points="1340,120 1362,60 1384,120"/>
        <rect x="1386" y="100" width="6" height="20" fill="#3a4a34"/>
      </g>
    </svg>
  </div>

  <!-- Grassy ground -->
  <div class="ground">
    <div class="ground-base"></div>
    <svg id="grassSvg" viewBox="0 0 1440 65" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"></svg>
    <div id="flowerLayer"></div>
  </div>

  <div class="puddle puddle-1"></div>
  <div class="puddle puddle-2"></div>
  <div class="puddle puddle-3"></div>

  <div class="rain-layer" id="rainLayer"></div>

  <!-- Pixel character -->
  <div class="character-wrap">
    <canvas class="pixel-canvas" id="pixelChar" width="208" height="256" style="width:104px;height:128px;"></canvas>
  </div>

  <div class="title-card">
    <div class="title-eyebrow">a place for your thoughts</div>
    <div class="title-main">cloud</div>
    <div class="title-sub">your gentle daily journal</div>
  </div>

  <div class="weather-badge">
    <span>🌧</span>
    <span>Light rain · 44°F · Forest Home</span>
  </div>

  <div class="enter-wrap">
    <button class="enter-btn" onclick="goToJournal()">Open my journal →</button>
  </div>
  <div class="swipe-hint">swipe right to enter · swipe left to return</div>
</div>


<!-- ══ JOURNAL PAGE ══ -->
<div class="page" id="journal-page">
  <div class="journal-scene">
    <div class="journal-sky"></div>
    <div class="window-pane"></div>
    <div class="journal-rain" id="journalRain"></div>
    <div class="journal-clouds" id="cloudLayerJournal"></div>
    <div class="journal-mountains">
