<script>
// ══════════════════════════════════════
// GHIBLI CLOUDS
// ══════════════════════════════════════
function makeClouds(id, count, darkMode) {
  const layer = document.getElementById(id);
  if (!layer) return;
  const templates = [
    (i,dk) => { const c1=dk?'#6a8898':'#a8c2cf', c2=dk?'#557080':'#88aabc';
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 95" width="220" height="95">
        <defs><radialGradient id="cg${i}" cx="50%" cy="65%" r="55%">
          <stop offset="0%" stop-color="${c1}" stop-opacity="0.88"/>
          <stop offset="100%" stop-color="${c2}" stop-opacity="0.5"/></radialGradient></defs>
        <ellipse cx="110" cy="72" rx="98" ry="26" fill="url(#cg${i})"/>
        <ellipse cx="72" cy="56" rx="42" ry="36" fill="url(#cg${i})"/>
        <ellipse cx="118" cy="48" rx="52" ry="42" fill="url(#cg${i})"/>
        <ellipse cx="168" cy="60" rx="38" ry="30" fill="url(#cg${i})"/>
      </svg>`; },
    (i,dk) => { const c1=dk?'#7a9ab5':'#b4ccd8', c2=dk?'#5c7888':'#90b0c0';
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 260 75" width="260" height="75">
        <defs><radialGradient id="cg${i}" cx="50%" cy="72%" r="55%">
          <stop offset="0%" stop-color="${c1}" stop-opacity="0.82"/>
          <stop offset="100%" stop-color="${c2}" stop-opacity="0.42"/></radialGradient></defs>
        <ellipse cx="130" cy="60" rx="118" ry="20" fill="url(#cg${i})"/>
        <ellipse cx="88" cy="46" rx="60" ry="32" fill="url(#cg${i})"/>
        <ellipse cx="158" cy="40" rx="72" ry="36" fill="url(#cg${i})"/>
      </svg>`; },
    (i,dk) => { const c1=dk?'#8aacbf':'#c0d4e0', c2=dk?'#6a8898':'#9abcc8';
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 150 88" width="150" height="88">
        <defs><radialGradient id="cg${i}" cx="50%" cy="62%" r="55%">
          <stop offset="0%" stop-color="${c1}" stop-opacity="0.9"/>
          <stop offset="100%" stop-color="${c2}" stop-opacity="0.5"/></radialGradient></defs>
        <ellipse cx="75" cy="66" rx="66" ry="24" fill="url(#cg${i})"/>
        <ellipse cx="52" cy="50" rx="34" ry="30" fill="url(#cg${i})"/>
        <ellipse cx="88" cy="44" rx="40" ry="36" fill="url(#cg${i})"/>
      </svg>`; },
  ];
  for (let i = 0; i < count; i++) {
    const tpl = templates[i % templates.length];
    const scale = 0.65 + Math.random() * 1.0;
    const top = Math.random() * 60;
    const startLeft = Math.random() < 0.6 ? -(250 * scale) : Math.random() * 70 + '%';
    const dur = 55 + Math.random() * 90;
    const delay = -(Math.random() * dur);
    const dir = Math.random() > 0.3 ? 'cloudDrift' : 'cloudDriftR';
    const op = 0.45 + Math.random() * 0.45;

    const w = document.createElement('div');
    w.className = 'ghibli-cloud';
    w.style.cssText = `top:${top}%;left:${typeof startLeft==='string'?startLeft:startLeft+'px'};transform:scale(${scale});transform-origin:top left;opacity:${op};animation:${dir} ${dur}s linear ${delay}s infinite;`;
    w.innerHTML = tpl(id+i, darkMode);
    layer.appendChild(w);
  }
}
makeClouds('cloudLayerWelcome', 11, false);
makeClouds('cloudLayerJournal', 7, true);

// ══════════════════════════════════════
// PIXEL CHARACTER (canvas, 8-bit)
// ══════════════════════════════════════
// We draw at 2x pixel resolution (each "pixel" = 2x2 actual canvas pixels → renders crisp at half CSS size)
const PXSIZE = 13; // canvas pixels per game pixel
const COLS = 16, ROWS = 20;

// Color palette
const P = {
  _: null,                     // transparent
  S: '#e8c99a', k: '#c9a870',  // skin light/dark
  H: '#4a5c44', h: '#384834',  // hat
  C: '#5e6a58', c: '#4a5446',  // coat
  F: '#96b5c0', f: '#7a9aaa',  // scarf
  B: '#3a302a',                // boot
  U: '#7a9ab5', u: '#5c7888',  // umbrella
  N: '#5c4a3a',                // handle
  E: '#1a1612',                // eye
  W: '#f0ebe2',                // eye white
  X: '#e8a090',                // cheek
};

// 16×20 pixel map
const PIX = [
/* 0 */ '....UUUUUUUU....',
/* 1 */ '...UUUuUUuUUU...',
/* 2 */ '..UUUuUUUUuUUU..',
/* 3 */ '..UUuUUUUUUuUU..',
/* 4 */ '.UUUuUUUUUUuUUU.',
/* 5 */ '......NNNN......',
/* 6 */ '.......NN.......',
/* 7 */ '....HHHHHHHH....',
/* 8 */ '...hHHHHHHHHh...',
/* 9 */ '...hHHHHHHHHh...',
/*10 */ '....SSSSkkSS....',
/*11 */ '...SSEESSEESSk..',
/*12 */ '....SSSSkkSSSS..',
/*13 */ '....SXSSSSSXSk..',
/*14 */ '...FFFCCCCCFFFf.',
/*15 */ '...FfCCCCCCCFf..',
/*16 */ '....CCCCCCCCCC..',
/*17 */ '...CCCCCCCCCCCC.',
/*18 */ '...BBBBk..BBBBk.',
/*19 */ '...BBBBk..BBBBk.',
];

function drawPixel(ctx, col, row, color) {
  if (!color) return;
  ctx.fillStyle = color;
  ctx.fillRect(col * PXSIZE, row * PXSIZE, PXSIZE, PXSIZE);
}

let pixFrame = 0;
function drawPixelChar() {
  const canvas = document.getElementById('pixelChar');
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  for (let r = 0; r < PIX.length; r++) {
    for (let c = 0; c < PIX[r].length; c++) {
      const ch = PIX[r][c];
      drawPixel(ctx, c, r, P[ch] || null);
    }
  }

  // Eye shine (animated blink every ~120 frames)
  if (pixFrame % 180 < 10) {
    // blink — draw eyelid over eyes
    ctx.fillStyle = P.S;
    ctx.fillRect(4*PXSIZE, 11*PXSIZE, 2*PXSIZE, PXSIZE);
    ctx.fillRect(9*PXSIZE, 11*PXSIZE, 2*PXSIZE, PXSIZE);
  } else {
    ctx.fillStyle = P.W;
    ctx.fillRect(4*PXSIZE, 10*PXSIZE, PXSIZE, PXSIZE);
    ctx.fillRect(9*PXSIZE, 10*PXSIZE, PXSIZE, PXSIZE);
  }

  // Animated rain drops hitting umbrella — pixel flashes
  const drops = [[2,0],[12,1],[6,2],[10,0],[14,2]];
  drops.forEach((d, i) => {
    if ((pixFrame + i * 17) % 30 < 6) {
      ctx.fillStyle = 'rgba(190,220,235,0.9)';
      ctx.fillRect(d[0]*PXSIZE, d[1]*PXSIZE, PXSIZE, PXSIZE/2);
    }
  });

  pixFrame++;
  requestAnimationFrame(drawPixelChar);
}
drawPixelChar();

// ══════════════════════════════════════
// GRASS
// ══════════════════════════════════════
function generateGrass() {
  const svg = document.getElementById('grassSvg');
  let d = '';
  for (let i = 0; i < 200; i++) {
    const x = (i / 200) * 1440 + (Math.random() * 8 - 4);
    const h = 20 + Math.random() * 32;
    const lean = (Math.random() - 0.45) * 18;
    const w = 1.5 + Math.random() * 2;
    const g = Math.floor(80 + Math.random() * 45);
    d += `<path d="M${x},65 Q${x+lean*0.5},${65-h*0.55} ${x+lean},${65-h}" fill="none" stroke="rgb(${g-10},${g+35},${g-20})" stroke-width="${w}" stroke-linecap="round" opacity="${0.6+Math.random()*0.38}"/>`;
  }
  svg.innerHTML = d;
}
generateGrass();

// ══════════════════════════════════════
// FLOWERS
// ══════════════════════════════════════
function generateFlowers() {
  const layer = document.getElementById('flowerLayer');
  const petalColors = ['#e8d0a0','#e2cad6','#cad6e2','#d5e2c8','#e8c8b2','#f0dab0','#d0c8e0'];
  const stemColor = '#6a8a5a';
  let html = '';
  for (let i = 0; i < 60; i++) {
    const left = Math.random() * 95 + 2;
    const bottom = Math.random() * 65 + 8;
    const scale = 0.7 + Math.random() * 0.8;
    const type = Math.floor(Math.random() * 4);
    const pc = petalColors[Math.floor(Math.random() * petalColors.length)];
    const cc = '#c9b882';
    let svg = '';
    if (type === 0) {
      // daisy
      let petals = '';
      for (let a = 0; a < 6; a++) {
        const ang = (a/6)*Math.PI*2;
        const px = 9 + Math.cos(ang)*6.5, py = 9 + Math.sin(ang)*6.5;
        petals += `<ellipse cx="${px.toFixed(1)}" cy="${py.toFixed(1)}" rx="2.8" ry="4.5" fill="${pc}" opacity="0.88" transform="rotate(${((a/6)*360).toFixed(0)} ${px.toFixed(1)} ${py.toFixed(1)})"/>`;
      }
      svg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="24" viewBox="0 0 18 24"><line x1="9" y1="24" x2="9" y2="12" stroke="${stemColor}" stroke-width="1.5"/>${petals}<circle cx="9" cy="9" r="3.8" fill="${cc}"/></svg>`;
    } else if (type === 1) {
      // bell wildflower
      svg = `<svg xmlns="http://www.w3.org/2000/svg" width="12" height="22" viewBox="0 0 12 22"><line x1="6" y1="22" x2="6" y2="10" stroke="${stemColor}" stroke-width="1.5"/><path d="M2,10 Q6,4 10,10 Q9,14 6,14 Q3,14 2,10Z" fill="${pc}" opacity="0.88"/><ellipse cx="6" cy="7" rx="2" ry="1.5" fill="${cc}"/></svg>`;
    } else if (type === 2) {
      // small round clover
      svg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="20" viewBox="0 0 16 20"><line x1="8" y1="20" x2="8" y2="10" stroke="${stemColor}" stroke-width="1.5"/><circle cx="6" cy="9" r="4" fill="#8ac07a" opacity="0.78"/><circle cx="10" cy="9" r="4" fill="#7ab06a" opacity="0.78"/><circle cx="8" cy="6" r="4" fill="#88bc78" opacity="0.78"/></svg>`;
    } else {
      // tiny bud
      svg = `<svg xmlns="http://www.w3.org/2000/svg" width="10" height="18" viewBox="0 0 10 18"><line x1="5" y1="18" x2="5" y2="8" stroke="${stemColor}" stroke-width="1.5"/><ellipse cx="5" cy="7" rx="3.5" ry="4.5" fill="${pc}" opacity="0.82"/><ellipse cx="5" cy="5" rx="2" ry="1.5" fill="${cc}"/></svg>`;
    }
    html += `<div class="flower" style="left:${left}%;bottom:${bottom}%;transform:scale(${scale});z-index:${Math.floor(bottom)};">${svg}</div>`;
  }
  layer.innerHTML = html;
}
generateFlowers();

// ══════════════════════════════════════
// RAIN
// ══════════════════════════════════════
function generateRain(layerId, count) {
  const layer = document.getElementById(layerId);
  if (!layer) return;
  for (let i = 0; i < count; i++) {
    const drop = document.createElement('div');
    drop.className = 'drop';
    drop.style.cssText = `left:${Math.random()*106}%;height:${Math.random()*16+10}px;animation-duration:${Math.random()*0.8+0.6}s;animation-delay:-${Math.random()*3}s;opacity:${Math.random()*0.4+0.25};`;
    layer.appendChild(drop);
  }
}
generateRain('rainLayer', 130);
generateRain('journalRain', 80);

// ══════════════════════════════════════
// STATE
// ══════════════════════════════════════
let entries = JSON.parse(localStorage.getItem('cloud_entries') || '[]');
let currentEntryId = null;
let selectedMood = '';
let editingId = null;

// ══════════════════════════════════════
// NAVIGATION
// ══════════════════════════════════════
function goToJournal() {
  const t = document.getElementById('transition');
  t.classList.add('in');
  setTimeout(() => {
    document.getElementById('welcome-page').classList.remove('active');
    document.getElementById('journal-page').classList.add('active');
    renderEntryList();
    t.classList.remove('in');
  }, 360);
}
function goToWelcome() {
  const t = document.getElementById('transition');
  t.classList.add('in');
  setTimeout(() => {
    document.getElementById('journal-page').classList.remove('active');
    document.getElementById('welcome-page').classList.add('active');
    t.classList.remove('in');
  }, 360);
}

// ══════════════════════════════════════
// MAC TRACKPAD SWIPE
// ══════════════════════════════════════
let wheelX = 0, wheelTimer = null;
document.addEventListener('wheel', e => {
  if (Math.abs(e.deltaX) < Math.abs(e.deltaY) * 0.4) return;
  wheelX += e.deltaX;
  clearTimeout(wheelTimer);
  wheelTimer = setTimeout(() => {
    if (Math.abs(wheelX) > 100) {
      const onWelcome = document.getElementById('welcome-page').classList.contains('active');
      const onJournal = document.getElementById('journal-page').classList.contains('active');
      if (onWelcome && wheelX > 0) goToJournal();
      if (onJournal && wheelX < 0) goToWelcome();
    }
    wheelX = 0;
  }, 75);
}, { passive: true });

// Touch swipe fallback
let touchX = null;
document.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, {passive:true});
document.addEventListener('touchend', e => {
  if (touchX === null) return;
  const dx = e.changedTouches[0].clientX - touchX;
  if (Math.abs(dx) > 60) {
    const onWelcome = document.getElementById('welcome-page').classList.contains('active');
    const onJournal = document.getElementById('journal-page').classList.contains('active');
    if (onWelcome && dx < 0) goToJournal();
    if (onJournal && dx > 0) goToWelcome();
  }
  touchX = null;
}, {passive:true});

// ══════════════════════════════════════
// EDITOR
// ══════════════════════════════════════
function openNewEntry() {
  editingId = null; selectedMood = ''; currentEntryId = null;
  document.querySelectorAll('.mood-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById('entryTitle').value = '';
  document.getElementById('entryBody').value = '';
  document.getElementById('wordCount').textContent = '0 words';
  document.getElementById('saveBtn').textContent = 'Save entry';
  document.getElementById('saveBtn').className = 'save-btn';
  document.getElementById('editorDateLine').textContent = new Date().toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
  showPanel('editor');
  document.querySelectorAll('.entry-item').forEach(e => e.classList.remove('active'));
}
function selectMood(btn) {
  document.querySelectorAll('.mood-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  selectedMood = btn.dataset.mood;
}
function autoResize(el) { el.style.height = 'auto'; el.style.height = el.scrollHeight + 'px'; }
function updateWordCount() {
  const t = document.getElementById('entryBody').value.trim();
  const n = t ? t.split(/\s+/).length : 0;
  document.getElementById('wordCount').textContent = n + (n===1?' word':' words');
}
function saveEntry() {
  const title = document.getElementById('entryTitle').value.trim() || 'Untitled';
  const body  = document.getElementById('entryBody').value.trim();
  if (!body) { showToast('Write something first ☁'); return; }
  if (editingId !== null) {
    const idx = entries.findIndex(e => e.id === editingId);
    if (idx > -1) { entries[idx].title = title; entries[idx].body = body; entries[idx].mood = selectedMood; }
    showToast('Entry updated ✓');
  } else {
    entries.unshift({id:Date.now(), title, body, mood:selectedMood, date:new Date().toISOString()});
    showToast('Entry saved ✓');
  }
  localStorage.setItem('cloud_entries', JSON.stringify(entries));
  renderEntryList();
  const btn = document.getElementById('saveBtn');
  btn.textContent = 'Saved ✓'; btn.className = 'save-btn saved';
  setTimeout(() => { btn.textContent = 'Save entry'; btn.className = 'save-btn'; }, 2000);
  editingId = null;
}

// ══════════════════════════════════════
// ENTRY LIST
// ══════════════════════════════════════
function renderEntryList() {
  const list = document.getElementById('entriesList');
  list.innerHTML = '';
  if (!entries.length) {
    list.innerHTML = '<div style="font-family:\'EB Garamond\',serif;font-style:italic;font-size:0.8rem;color:rgba(182,205,216,0.32);padding:6px 4px;">No entries yet</div>';
    return;
  }
  entries.forEach(entry => {
    const d = new Date(entry.date);
    const item = document.createElement('div');
    item.className = 'entry-item' + (entry.id === currentEntryId ? ' active' : '');
    item.innerHTML = `<div class="entry-item-title">${escHtml(entry.title)}</div><div class="entry-item-date">${d.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</div>${entry.mood?`<div class="entry-item-mood">${entry.mood}</div>`:''}`;
    item.onclick = () => viewEntry(entry.id);
    list.appendChild(item);
  });
}
function viewEntry(id) {
  const entry = entries.find(e => e.id === id);
  if (!entry) return;
  currentEntryId = id;
  document.querySelectorAll('.entry-item').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.entry-item').forEach(el => {
    if (el.querySelector('.entry-item-title')?.textContent === entry.title) el.classList.add('active');
  });
  const d = new Date(entry.date);
  document.getElementById('viewMood').textContent  = entry.mood || '';
  document.getElementById('viewDate').textContent  = d.toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
  document.getElementById('viewTitle').textContent = entry.title;
  document.getElementById('viewBody').textContent  = entry.body;
  showPanel('view');
  renderEntryList();
}
function editCurrentEntry() {
  const entry = entries.find(e => e.id === currentEntryId);
  if (!entry) return;
  editingId = currentEntryId;
  document.getElementById('entryTitle').value = entry.title;
  document.getElementById('entryBody').value  = entry.body;
  selectedMood = entry.mood || '';
  document.querySelectorAll('.mood-btn').forEach(b => b.classList.toggle('selected', b.dataset.mood === selectedMood));
  updateWordCount();
  document.getElementById('editorDateLine').textContent = new Date(entry.date).toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
  document.getElementById('saveBtn').textContent = 'Save changes';
  showPanel('editor');
}
function deleteCurrentEntry() {
  if (!currentEntryId) return;
  entries = entries.filter(e => e.id !== currentEntryId);
  localStorage.setItem('cloud_entries', JSON.stringify(entries));
  currentEntryId = null;
  renderEntryList();
  showPanel('empty');
  showToast('Entry deleted');
}

// ══════════════════════════════════════
// PANELS
// ══════════════════════════════════════
function showPanel(which) {
  document.getElementById('emptyState').style.display  = which==='empty'  ? 'flex' : 'none';
  document.getElementById('editorWrap').style.display  = which==='editor' ? 'flex' : 'none';
  document.getElementById('viewEntry').style.display   = which==='view'   ? 'flex' : 'none';
}

// ══════════════════════════════════════
// TOAST
// ══════════════════════════════════════
let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
}

function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

renderEntryList();
</script>
</body>
</html>
